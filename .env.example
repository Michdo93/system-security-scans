# SMTP settings for alert mail (use an app password; never the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
YARA_RULES=/opt/yara-patterns/all-hfu.yar
SCAN_ROOT=/
YARA_EXCLUDED_PATHS=/opt/yara-patterns,/opt/yara-4.4.0,/opt/thor-lite/custom-signatures/yara,/sys,/dev,/proc
YARA_EXCLUDED_EXTENSIONS=.yar,.yara,.yac,.yas,.yasx,.yms,.jsos,.dat
CLAMAV_LOG=/var/log/clamav_infected.log
CHKROOTKIT_LOG=/var/log/chkrootkit.log
AIDE_CONFIG=/etc/aide/aide.conf
